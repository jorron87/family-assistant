# Only deliberate source/documentation locations may enter a release.
/*
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/.github/
!/.githooks/
!/src/
!/public/
!/test/
!/scripts/
!/config/
!/docs/
/docs/*
!/docs/aktiviteter.md
!/docs/architecture.md
!/docs/integrations.md
!/docs/kildegjennomgang-policy.md
!/docs/mobilinnsending.md
!/docs/operations.md
!/docs/release-review.md
!/docs/ringeklokke.md
!/docs/runbook.md
!/docs/setup.md
!/docs/git-workflow.md
node_modules/
config/*.json
!config/*.example.json
.family-data/
.runtime/
tmp/
artifacts/
coverage/
*.log
*.enc
*.dpapi
.env*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.bak

docs/drift/
docs/audit/
.local/
